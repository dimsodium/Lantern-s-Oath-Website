# Lantern's Oath environment variables.
# Copy this file to .env.local for local development (it is git-ignored), and add the same keys
# in Vercel → Project → Settings → Environment Variables before deploying.

# ---- Firebase (login): Firebase console → Project settings → Your apps → Web app config
# These are public browser keys (safe to ship); the VITE_ prefix makes them available to the site.
# Leave them empty and the site runs guest-only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# ---- Server side (Vercel functions in /api): keep these secret
# Same project ID as above; used to verify sign-in tokens.
FIREBASE_PROJECT_ID=your-project
# Turso database: `turso db show <db> --url` and `turso db tokens create <db>`
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=
